# ─────────────────────────────────────────────────────────────────────────────
# Светофор — настройки. Скопируйте в .env:  cp .env.example .env
# Без LLM_API_KEY приложение работает в демо-режиме (пример проверяется по записанным ответам).
# ─────────────────────────────────────────────────────────────────────────────

# --- Веб ---
APP_PORT=8080
# Не короче 32 символов. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Пусто — при первом запуске создаётся случайный секрет и хранится в томе данных (/data/jwt_secret)
JWT_SECRET=
JWT_TTL_MINUTES=720
# Демо-учётки specialist/methodologist/admin@demo.ru — для жюри; вне демонстрации DEMO_USERS=false
DEMO_USERS=true
DEMO_USERS_PASSWORD=demo
# Описание API без входа (/api/docs, /api/openapi.json) — для жюри; вне демонстрации API_DOCS=false
API_DOCS=true

# --- LLM: любой OpenAI-совместимый провайдер ---
# live    — обычные запросы;  record — запросы + запись ответов в кэш;  replay — только из кэша
LLM_MODE=live
LLM_BASE_URL=
LLM_API_KEY=
# проект или каталог провайдера (заголовок OpenAI-Project), если провайдер его требует; иначе пусто
LLM_PROJECT=
# качество измерено и демо-кассета записана на DeepSeek V4.1 Flash (у нашего провайдера —
# deepseek-v4.1-flash, основная и быстрая — одна модель); на другой модели результат будет другим
LLM_MODEL_MAIN=
LLM_MODEL_FAST=
# true, если провайдер поддерживает response_format=json_schema (vLLM и др.)
LLM_SUPPORTS_JSON_SCHEMA=false
LLM_MAX_CONCURRENCY=8
LLM_RPM=60
LLM_TPM=200000
LLM_TIMEOUT_S=120
# Запас токенов на рассуждения (o-серия, GPT-5, DeepSeek-R1): добавляется к длине ответа
LLM_REASONING_TOKENS=4000
# Длина контекста модели в токенах: из неё — сколько текста документа класть в промпт
# (локальная модель с max_model_len 8192 — поставьте 8192)
LLM_CONTEXT_TOKENS=32768
# Второе мнение модели по красным нарушениям: несогласие — «требует проверки специалистом»
LLM_SECOND_OPINION=true
GREEN_SWEEP=false
# Писать тексты промптов и ответов в журнал (только для отладки)
LLM_LOG_BODIES=false

# --- Эмбеддинги (сервис embedder) ---
EMBED_URL=http://embedder:80
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DIM=384

# --- Лимиты обработки ---
MAX_UPLOAD_MB=100
# одновременных проверок у одного пользователя (каждая — вызовы платной модели); сверх — 429
MAX_ACTIVE_CHECKS_PER_USER=5
# загрузка закупки из ЕИС по номеру; false — сервис не обращается к ЕИС
EIS_FETCH=true
MAX_UNPACKED_MB=1024
MAX_FILES=200
MAX_ARCHIVE_DEPTH=2
MAX_COMPRESSION_RATIO=100
MAX_PAGES_PER_DOC=1000
OCR_MIN_CHARS=50
# страниц скана параллельно в одном документе; каждая — около 100 МБ памяти,
# воркеров 4 (INGEST_CONCURRENCY) — на машине с 8 ГБ памяти ставьте 2
OCR_JOBS=4
OCR_LANGUAGES=rus+eng
# Распаковка RAR, 7z, tar: bsdtar из пакета libarchive-tools (в Windows подходит встроенный tar.exe)
BSDTAR=bsdtar
QUOTE_MIN_SCORE=92
CHUNK_MAX_TOKENS=700
LEGAL_STALE_DAYS=180

# --- Инфраструктура (менять обычно не нужно) ---
POSTGRES_USER=svetofor
POSTGRES_PASSWORD=svetofor
POSTGRES_DB=svetofor
DATABASE_URL=postgresql+psycopg://svetofor:svetofor@postgres:5432/svetofor
REDIS_URL=redis://redis:6379/0
# Наборы правил YAML для первой загрузки и набор по умолчанию для новых проверок
RULES_DIR=/app/rules
DEFAULT_RULESET=44fz-supplier-base
# Порт метрик Prometheus у каждого воркера Celery (0 — не поднимать)
METRICS_PORT=9100
DATA_DIR=/data
LOG_LEVEL=INFO
LOG_JSON=true
